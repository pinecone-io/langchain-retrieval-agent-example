{
  "name": "langchain-retrieval-agent-example",
  "version": "1.0.0",
  "description": "Example of a retrieval-augmented LangChain agent backed by a Pinecone vector index.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinecone-io/langchain-retrieval-agent-example.git"
  },
  "scripts": {
    "index": "tsx -r dotenv/config src/index.ts",
    "chat": "tsx -r dotenv/config src/chat.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint src",
    "lint:fix": "npm run lint --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --list-different \"**/*.ts\""
  },
  "keywords": [
    "pinecone",
    "langchain",
    "rag",
    "openai",
    "typescript",
    "vector-search"
  ],
  "author": "Pinecone",
  "license": "MIT",
  "dependencies": {
    "@langchain/classic": "^1.0.40",
    "@langchain/core": "^1.2.2",
    "@langchain/openai": "^1.5.5",
    "@langchain/pinecone": "^1.0.3",
    "@pinecone-database/pinecone": "^8.0.0",
    "@huggingface/transformers": "^4.2.0",
    "chalk": "^5.2.0",
    "cli-progress": "^3.12.0",
    "cross-fetch": "^3.1.6",
    "dotenv": "^16.1.3",
    "json2csv": "^6.0.0-alpha.2",
    "langchain": "^1.5.3",
    "onnxruntime-node": "^1.15.0"
  },
  "overrides": {
    "@pinecone-database/pinecone": "^8.0.0",
    "rollup": "4.62.2",
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.2",
    "@types/cli-progress": "^3.11.0",
    "@types/js-yaml": "^4",
    "@types/json2csv": "^5.0.3",
    "@types/node": "^18.15.5",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.51.0",
    "eslint": "^8.33.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.3",
    "tsx": "^4.23.1",
    "typescript": "^5.0.4",
    "vitest": "^3.2.7"
  }
}
